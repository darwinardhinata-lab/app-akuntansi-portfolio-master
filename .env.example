APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =============================================================================
# CEISA H2H Integration (Customs/Bea Cukai)
# Dokumentasi: https://ceisa.beacukai.go.id atau sesuai info dari DJBC/PPJK
# =============================================================================

# Environment: 'sandbox' atau 'production'
CEISA_ENABLED=false
CEISA_ENV=sandbox

# Base URL CEISA H2H
CEISA_SANDBOX_BASE_URL=https://sandbox-ceisa.beacukai.go.id/api
CEISA_PRODUCTION_BASE_URL=https://production-ceisa.beacukai.go.id/api

# Timeout HTTP request (detik)
CEISA_TIMEOUT=30

# Retry configuration
CEISA_RETRY_TIMES=3

# Polling interval (menit)
CEISA_POLLING_INTERVAL=15

# Metode signing: 'hmac' atau 'x509'
CEISA_SIGN_METHOD=hmac

# Kredensial HMAC (jika menggunakan API Key/Secret)
CEISA_API_KEY=
CEISA_API_SECRET=

# Kredensial X.509 (jika menggunakan sertifikat elektronik)
CEISA_CERT_PATH=
CEISA_CERT_PASSWORD=
CEISA_PRIVATE_KEY_PATH=

# Webhook Configuration
CEISA_WEBHOOK_URL=
CEISA_WEBHOOK_SECRET=
CEISA_WEBHOOK_ENABLED=false

# Default kode kantor pabean
CEISA_DEFAULT_KODE_KANTOR=BE001

# PPJK Configuration (jika submission melalui PPJK)
CEISA_PPJK_ENABLED=false
CEISA_PPJK_NAMA=
CEISA_PPJK_KODE=

# Auto-post jurnal saat SPPB/NPE terbit
CEISA_AUTO_POST_JOURNAL=true

# Akun untuk jurnal bea masuk (sesuaikan dengan chart of accounts Anda)
CEISA_ACCOUNT_BEA_MASUK=60010000
CEISA_ACCOUNT_PPN_IMPOR=21010000
CEISA_ACCOUNT_PERSEDIAAN=10010000
CEISA_ACCOUNT_HUTANG_BM=21020000

# Logging
CEISA_LOG_RAW_PAYLOADS=false
CEISA_LOG_CHANNEL=stack

# =============================================================================
# End CEISA H2H Configuration
# =============================================================================

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
